DATABASE_URL=postgresql+psycopg://fleetflow:fleetflow_dev_password@localhost:5432/fleetflow
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-before-sharing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set a long random key shared with your physical GPS tracker integration
GPS_DEVICE_API_KEY=replace-with-a-long-random-device-key

# Optional: enables live traffic-aware Google Routes calculations. Leave blank to use OSRM + estimated congestion.
GOOGLE_ROUTES_API_KEY=
